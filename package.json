{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/nashwan-portfolio",
    "build": "npm run build --workspace=@workspace/nashwan-portfolio",
    "build:api": "npm run build --workspace=@workspace/api-server",
    "typecheck:libs": "tsc --build ./lib/db ./lib/api-zod ./lib/api-client-react",
    "lint": "tsc -p ./artifacts/nashwan-portfolio/tsconfig.json --noEmit",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
