{
  "version": 2,
  "buildCommand": "node node_modules/vite/bin/vite.js build --config artifacts/nashwan-portfolio/vite.config.ts",
  "installCommand": "npm install --include=dev --legacy-peer-deps",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
